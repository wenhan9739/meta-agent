# 本地数据与密钥 — 绝不入库
.env
*.env
!.env.example
.credentials.yaml
**/.credentials.yaml

# 用户项目数据（含未发表研究数据，隐私敏感）
projects/*
!projects/.gitkeep

# dsh 运行时产物
.dsh/profiles/
.dsh/storages/

# 部署构建/运行时产物 — 不入库（每个环境自行生成）
deploy/workspace/
deploy/*.tgz
deploy/*.tar.gz
deploy/Caddyfile.prod
deploy/docker-compose.override.yml

# 杂项
manuscript.docx
deepseek-harness.del/
.workbuddy/
*.log
__pycache__/
.Rhistory
.RData
*.Rproj
