# Meta-Agent 网关 - magpieagent.online (多用户内测版)
# 安全模型: Basic Auth + Caddy TLS (Let's Encrypt 自动证书)
# dsh 特权 API 钉死 loopback, 计费 Key 由环境变量注入, 用户无法读取
# 性能优化: 仅对静态资产 (/assets/*, /plugins/*) 开启 gzip/zstd 压缩与 immutable 长缓存
#   - /assets/* 与 /plugins/* 的 URL 含内容哈希 (rev/文件名), 可安全 1 年强缓存
#   - API/SSE 走默认 handle, 保持 flush_interval(-1) 流式输出, 不做压缩以免影响长连接

magpieagent.online, www.magpieagent.online {
    basic_auth {
        alice $2a$14$iCmp0.aPsEK5cc.wQWvxtus8cV6mcLeMONeUJ1aK63JHOANqVQnl6
        13677074595 $2a$14$DH7Fo7LnLbnopKEbdu1UzeDKD4rlT0moUDp.K4UZn84yaMYNH9gTS
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
    }

    @static path /assets/* /plugins/* /manifest.webmanifest /favicon.svg
    handle @static {
        encode gzip zstd
        # Caddy's deferred response headers apply in set->delete order; deleting a
        # harmless header (ETag) makes the handler deferred so our Cache-Control
        # runs AFTER the proxy, overriding dsh's upstream "no-cache".
        header {
            -ETag
            Cache-Control "public, max-age=31536000, immutable"
        }
        reverse_proxy agent-alice:8080
    }
    handle {
        reverse_proxy agent-alice:8080 {
            flush_interval -1
        }
    }
}

http://magpieagent.online, http://www.magpieagent.online {
    redir https://{host}{uri} permanent
}
